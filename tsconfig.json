{
  "compilerOptions": {
    "target": "es2021",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitAny": true,
    "noEmit": true,
    "lib": [
      "es2021",
      "dom"
    ]
  },
  "include": [
    "guest-js/index.ts"
  ],
  "exclude": [
    "dist-js",
    "node_modules"
  ]
}